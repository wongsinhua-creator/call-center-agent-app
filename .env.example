# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only — used by /api/complaints to auto-tag new complaints.
# If unset, the app falls back to a deterministic rule-based classifier
# (see lib/ai/classify.ts) so submissions still get tagged.
OPENAI_API_KEY=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
